# ============================================================================
# Levvy Backend — Production & Local Environment Variables (.env)
# Copy this file to `.env` in `backend/` or repo root. Never commit `.env`.
# ============================================================================

# 1. Database (Vultr Managed PostgreSQL in prod; set DATABASE_PROVIDER=sqlite for local fallback)
DATABASE_PROVIDER=postgres
DATABASE_URL=Host=your-vultr-pg-host.vultrdb.com;Port=16751;Database=levvy;Username=vultradmin;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# 2. Groq AI (Speech-to-Text + Translation + Grounded Ask Levvy + Study Pack)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/
GROQ_ANSWER_MODEL=gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GROQ_ASR_MODEL=whisper-large-v3-turbo

# 3. Deepgram (Fallback or Primary ASR Strategy)
ASR_PROVIDER=groq
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1/
DEEPGRAM_MODEL=nova-2

# 4. Vultr Object Storage (S3-Compatible Audio & Study Pack Store)
STORAGE_ENDPOINT=ewr1.vultrobjects.com
STORAGE_REGION=ewr1
STORAGE_BUCKET=levvy-recordings
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 5. Authentication & Google Sign-In
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ISSUER=levvy-api
JWT_AUDIENCE=levvy-web
JWT_EXPIRY_MINUTES=120
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. Online Class Bot (plan.md Phase 2 — Meeting BaaS API v2 by default; Recall.ai https://api.recall.ai/api/v1/ also supported)
# Leave MEETING_BOT_API_KEY empty to run in Mode B (browser tab audio via /ws/{sessionId}).
MEETING_BOT_API_KEY=
MEETING_BOT_API_BASE_URL=https://api.meetingbaas.com/v2/
MEETING_BOT_WEBHOOK_SECRET=

# 7. Audit hardening (rate limiting, CORS, WebSocket host key, Hangfire dashboard, ASR tuning)
# Comma-separated frontend origins allowed by CORS (required in production; wildcard fallback only in dev):
CORS_ALLOWED_ORIGINS=https://levvy.tech,http://localhost:3000
# Shared secret a WS client may present as ?host_key=... or X-Host-Key header to claim the host role
# on zero-account demo sessions (JWT sub==HostId always works too). Leave empty to rely on JWT/anonymous-demo rules:
WS_HOST_KEY=
# Required to access the Hangfire dashboard at /jobs outside local development:
HANGFIRE_DASHBOARD_TOKEN=
# Default live-audio chunk duration in milliseconds (host-reported chunk_meta overrides; clamped 1000-60000):
ASR_CHUNK_DURATION_MS=5000
